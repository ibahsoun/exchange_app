# Database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exchange_terminal?schema=public"

# Server port
PORT=4000

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Rate refresh interval in milliseconds (how often rates are pulled)
RATE_REFRESH_INTERVAL=5000

# Multi-source refresh interval (default 30s)
MULTI_SOURCE_REFRESH_MS=30000

# ─── Live Market API (the only external rate source) ───────
# Beta Broadcaster: https://platform.betaserver.dev/fxrates/{pair}
# The defaults below match the live feed — no key required today.

LIVE_MARKET_BASE_URL=https://platform.betaserver.dev
LIVE_MARKET_RATES_PATH=/fxrates

# per-pair = GET /fxrates/{pair} per symbol (documented)
# stats    = GET /fxrates/stats, every pair in one request
LIVE_MARKET_FETCH_MODE=per-pair

# Auth: none | query | bearer | header | basic. The feed is currently open.
LIVE_MARKET_AUTH_SCHEME=none
LIVE_MARKET_API_KEY=
LIVE_MARKET_API_SECRET=
# Query-param name (authScheme=query) or header name (authScheme=header)
LIVE_MARKET_AUTH_KEY_NAME=apikey

# Source key + label shown in the UI and stored in RateSource.name
LIVE_MARKET_SOURCE_KEY=betaserver
LIVE_MARKET_LABEL=Beta Broadcaster

# Request timeout, response reuse window, and staleness threshold (ms).
# Staleness is measured against received_at_utc, so a weekend-old lp_time is fine.
LIVE_MARKET_TIMEOUT_MS=8000
LIVE_MARKET_CACHE_MS=2000
LIVE_MARKET_STALE_MS=120000

# Pair -> vendor symbol. Merged over the built-in map (BRL direct, USDT derived).
# Add pairs here as the feed turns them on, no deploy needed:
#   invert=true      -> vendor quotes QUOTE/USD instead of USD/QUOTE
#   derive           -> compute a cross from two vendor symbols
# LIVE_MARKET_SYMBOLS={"CNY":"usdcny","EUR":{"symbol":"eurusd","invert":true}}
LIVE_MARKET_SYMBOLS=

# Set to false to force mock rates even when the vars above are filled in
LIVE_MARKET_ENABLED=true
